+// selectReadyWorkerPod chooses a stable, Ready worker pod to execute operation commands.
+//
+// Selection is a pure function of the observed cluster state: candidate pods must belong
+// to the worker StatefulSet, not be terminating, be Running with the PodReady condition
+// true and the target container Ready. Candidates are ordered by StatefulSet ordinal and
+// the lowest one wins, which makes the result deterministic across reconciles, controller
+// restarts, rolling updates and scaling. With a single replica this still resolves to
+// worker-0, preserving the historical default path.
+//
+// The identity is resolved once per command and pinned for the command's duration; a pod
+// that fails drops out of the Ready set and the next command (the next reconcile retry)
+// fails over to the next healthy ordinal. When zero replicas are configured or no pod is
+// Ready, an ExecutionPodUnavailableError is returned without touching any status state.
+func (h *workersOnlyArchApi) selectReadyWorkerPod(workerName, containerName string) (string, error) {
+	if h.client == nil {
+		// Without a client the live pod state cannot be observed. Never guess worker-0
+		// here: exec-ing into an unchecked pod would defeat the readiness selection.
+		return "", newExecutionPodUnavailable(workerName,
+			ExecutionPodUnavailableReasonNoReadyPod, "runtime client is not initialized")
+	}
+
+	// The worker StatefulSet is the authoritative source of the desired replica count and
+	// pod ownership. Relying on the CacheRuntime spec instead would misfire when its
+	// replicas field is left at the zero value while the workload already runs pods.
+	sts := &workloadv1alpha1.AdvancedStatefulSet{}
+	err := h.client.Get(context.TODO(), types.NamespacedName{Name: workerName, Namespace: h.namespace}, sts)
+	if err != nil {
+		if apierrors.IsNotFound(err) {
+			return "", newExecutionPodUnavailable(workerName,
+				ExecutionPodUnavailableReasonWorkloadNotFound, "worker statefulset has not been created")
+		}
+		return "", errors.Wrapf(err, "failed to get worker statefulset %s/%s", h.namespace, workerName)
+	}
+
+	if sts.Spec.Replicas != nil && *sts.Spec.Replicas == 0 {
+		return "", newExecutionPodUnavailable(workerName,
+			ExecutionPodUnavailableReasonZeroReplicas, "worker statefulset replicas is scaled to 0")
+	}
+
+	selector, err := metav1.LabelSelectorAsSelector(sts.Spec.Selector)
+	if err != nil {
+		return "", errors.Wrapf(err, "failed to parse selector of worker statefulset %s", workerName)
+	}
+
+	podList := &corev1.PodList{}
+	if err = h.client.List(context.TODO(), podList,
+		client.InNamespace(h.namespace),
+		client.MatchingLabelsSelector{Selector: selector}); err != nil {
+		return "", errors.Wrapf(err, "failed to list pods of worker statefulset %s", workerName)
+	}
+
+	readyPods := make([]corev1.Pod, 0, len(podList.Items))
+	for _, pod := range podList.Items {
+		if _, ok := workerPodOrdinal(pod.Name, workerName); !ok {
+			// Ignore pods that only share labels but are not members of this StatefulSet.
+			continue
+		}
+		if isReadyExecutionPod(&pod, containerName) {
+			readyPods = append(readyPods, pod)
+		}
+	}
+
+	if len(readyPods) == 0 {
+		return "", newExecutionPodUnavailable(workerName,
+			ExecutionPodUnavailableReasonNoReadyPod,
+			buildNoReadyPodDetail(podList.Items, containerName))
+	}
+
+	// Lowest ordinal wins; name is a deterministic tie-breaker for safety.
+	sort.Slice(readyPods, func(i, j int) bool {
+		ordinalI, _ := workerPodOrdinal(readyPods[i].Name, workerName)
+		ordinalJ, _ := workerPodOrdinal(readyPods[j].Name, workerName)
+		if ordinalI != ordinalJ {
+			return ordinalI < ordinalJ
+		}
+		return readyPods[i].Name < readyPods[j].Name
+	})
+
+	return readyPods[0].Name, nil
+}
+
+// isReadyExecutionPod tells whether the pod can safely serve an exec command in the
+// target container: not terminating, Running, PodReady and the named container Ready.
+func isReadyExecutionPod(pod *corev1.Pod, containerName string) bool {
+	if pod == nil {
+		return false
+	}
+	// A pod under deletion (rolling replacement, scale down) must not receive new commands.
+	if pod.DeletionTimestamp != nil {
+		return false
+	}
+	if pod.Status.Phase != corev1.PodRunning || !podutil.IsPodReady(pod) {
+		return false
+	}
+	// Coordinate with the container identity resolved from the pod template: only a pod
+	// whose target container reports Ready is eligible.
+	for _, containerStatus := range pod.Status.ContainerStatuses {
+		if containerStatus.Name == containerName {
+			return containerStatus.Ready
+		}
+	}
+	return false
+}
+
+// workerPodOrdinal parses the ordinal of a StatefulSet pod and verifies it belongs to
+// the expected worker workload.
+func workerPodOrdinal(podName, workerName string) (int, bool) {
+	matches := statefulPodNameRegex.FindStringSubmatch(podName)
+	if len(matches) != 3 || matches[1] != workerName {
+		return 0, false
+	}
+	ordinal, err := strconv.Atoi(matches[2])
+	if err != nil {
+		return 0, false
+	}
+	return ordinal, true
+}
+
+// buildNoReadyPodDetail summarizes the observed worker pods for the unavailable error
+// message, which keeps the cause explicit without writing anything into status.
+func buildNoReadyPodDetail(pods []corev1.Pod, containerName string) string {
+	if len(pods) == 0 {
+		return "no worker pod observed"
+	}
+
+	readyCount := 0
+	for i := range pods {
+		if isReadyExecutionPod(&pods[i], containerName) {
+			readyCount++
+		}
+	}
+	return "observed " + strconv.Itoa(len(pods)) + " worker pod(s), " +
+		strconv.Itoa(readyCount) + " ready"
+}
