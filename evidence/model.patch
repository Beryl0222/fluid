diff --git a/pkg/controllers/v1alpha1/datamigrate/spec_binding_test.go b/pkg/controllers/v1alpha1/datamigrate/spec_binding_test.go
new file mode 100644
index 0000000..83d0248
--- /dev/null
+++ b/pkg/controllers/v1alpha1/datamigrate/spec_binding_test.go
@@ -0,0 +1,157 @@
+/*
+Copyright 2026 The Fluid Authors.
+
