diff --git a/pkg/controllers/v1alpha1/dataflow/dependency_reconcile_test.go b/pkg/controllers/v1alpha1/dataflow/dependency_reconcile_test.go
new file mode 100644
index 0000000..48337f6
--- /dev/null
+++ b/pkg/controllers/v1alpha1/dataflow/dependency_reconcile_test.go
@@ -0,0 +1,367 @@
+/*
