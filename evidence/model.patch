diff --git a/pkg/controllers/v1alpha1/dataflow/dependency_lifecycle_test.go b/pkg/controllers/v1alpha1/dataflow/dependency_lifecycle_test.go
new file mode 100644
index 0000000..e653d47
--- /dev/null
+++ b/pkg/controllers/v1alpha1/dataflow/dependency_lifecycle_test.go
@@ -0,0 +1,460 @@
+/*
