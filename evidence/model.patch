+
+			// Freeze the original (generation 1) spec, then simulate a live drift to generation 2.
+			Expect(FreezeAcceptedSpec(base, liveObj)).To(Succeed())
+			frozenAnnotation := liveObj.GetAnnotations()[AcceptedSpecAnnotation]
